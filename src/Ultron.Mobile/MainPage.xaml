<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="#1c1b19" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ultron.Mobile"
             xmlns:components="clr-namespace:Ultron.Mobile.Components"
             x:Class="Ultron.Mobile.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>

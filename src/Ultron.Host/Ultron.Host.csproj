<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Ultron.Core\Ultron.Core.csproj" />
    <ProjectReference Include="..\Ultron.Infrastructure\Ultron.Infrastructure.csproj" />
    <ProjectReference Include="..\Ultron.Contracts\Ultron.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Telegram bot token gibi gizli ayarlar: dotnet user-secrets set "Telegram:BotToken" "TOKEN" (proje: src/Ultron.Host) -->
    <UserSecretsId>ultron-host-secrets</UserSecretsId>
  </PropertyGroup>

  <!-- Mühendislik ders notları (yerel kütüphane kaynağı "muhendislik"): Host klasörüne kopyalanır, yayımla da gider. -->
  <ItemGroup>
    <None Include="notlar\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

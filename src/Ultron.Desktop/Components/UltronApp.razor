    /// <summary>Kutunun boyu cevabın uzunluğuna göre (16:9 korunur): kısa → küçük, uzun → büyük.</summary>
    private string BoxSize
    {
        get
        {
            var answer = _messages.LastOrDefault(m => !m.IsUser);
            var length = (answer?.Text.Length ?? 0) + (answer?.Sources.Count ?? 0) * 80 + (answer is { ExtraOpen: true } ? 300 : 0);
            return length switch { < 240 => "s", < 800 => "m", < 1800 => "l", _ => "xl" };
        }
    }


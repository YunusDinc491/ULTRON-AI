    }

    /// <summary>Arayüz açıkken "Ultron" duyuldu: dinle, cevapla, sonra 10 sn "Ultron" demeden ek soru bekle.</summary>
    private void OnMainWake() => InvokeAsync(async () =>
    {
        if (_listening || _transcribing)
            return;
        _wakeSession = true;
        await ListenAsync(followUp: false);
    });

    private bool _wakeSession;

    private async Task ListenAsync(bool followUp)
    {
        if (_listening)
        {
            _finishRecording?.Cancel();
            return;
        }
        if (!_ready || _transcribing)
            return;

        _player?.Stop();
        _sendCts?.Cancel();
        PauseIdleTimer();
        _listening = true;
        _status = followUp ? "DEVAM EDEBİLİRSİN (10 SN)" : "DİNLİYOR";
        StateHasChanged();
        _ = Client.PrepareVoiceAsync().ContinueWith(t => DesktopLog.Write("Ses hazırlığı: " + t.Exception?.GetBaseException().Message),
            TaskContinuationOptions.OnlyOnFaulted);

        byte[]? wav;
        _finishRecording = new CancellationTokenSource();
        _abortRecording = new CancellationTokenSource();
        try
        {
            wav = await _recorder.RecordAsync(_finishRecording.Token, _abortRecording.Token, followUp ? WakeWordRules.FollowUpMs : null);
        }
        catch (Exception ex)
        {
            DesktopLog.Write("Mikrofon hatası: " + ex);
            _status = "MİKROFON AÇILAMADI";
            return;
        }
        finally
        {
            _listening = false;
            _finishRecording.Dispose();
            _abortRecording.Dispose();
            _abortRecording = null;
            _finishRecording = null;
            StateHasChanged();
        }

        if (wav is null)
        {
            SetIdle();
            _status = followUp ? "ÇEVRİMİÇİ" : "SES DUYULMADI";
            _wakeSession = false;
            RestartIdleTimer();
            return;
        }

        _transcribing = true;
        _orbState = OrbState.Thinking;
        _status = "ANLIYOR";
        StateHasChanged();
        string text;
        try
        {
            text = await Client.TranscribeAsync(wav);
            DesktopLog.Write($"Ses kaydı {wav.Length / 32000.0:F1} sn → {(text.Length == 0 ? "(anlaşılmadı)" : text.Length + " karakter")}");
        }
        catch (Exception ex)
        {
            DesktopLog.Write("Yazıya çevirme hatası: " + ex);
            text = "";
        }
        finally
        {
            _transcribing = false;
        }

        if (string.IsNullOrWhiteSpace(text))
        {
            SetIdle();
            _status = "ANLAŞILMADI, TEKRAR DENE";
            RestartIdleTimer();
            StateHasChanged();
            return;
        }

        await SendAsync(text, speak: true);
        // Her sesli sorudan sonra (düğme ya da "Ultron"; kullanıcı 2026-10-29) Ultron konuşmayı bitirsin (kendi sesini kaydetmesin), sonra 10 sn ek soruyu dinle.
        while (_busy || _player is { IsSpeaking: true })
            await Task.Delay(150);
        if (!_listening)
            await ListenAsync(followUp: true);
    }

    /// <summary>Ses seviyesini küreye iletir. Ses iş parçacığından saniyede ~30 kez gelir; 40 ms'de bire indirilir.</summary>
    private void SendLevel(float level)
    {
        var now = Environment.TickCount64;
        if (level > 0 && now - Interlocked.Read(ref _lastLevelTicks) < 40)
            return;
        Interlocked.Exchange(ref _lastLevelTicks, now);
        _ = InvokeAsync(async () =>
        {
            try
            {
                await JS.InvokeVoidAsync("ultronCore.setLevel", level);
            }
            catch (JSDisconnectedException)
            {
            }
        });
    }


    private PendingImage? _pendingImage;

    private async Task OnImagePickedAsync(InputFileChangeEventArgs e) => await SetPendingImageAsync(e.File);

    private async Task SetPendingImageAsync(IBrowserFile file)
    {
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 30L * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _pendingImage = new PendingImage(ImageTools.Prepare(buffer.ToArray()), file.Name);
        }
        catch (Exception ex)
        {
            DesktopLog.Write($"Görsel okunamadı ({file.Name}): {ex.Message}");
            _status = "GÖRSEL OKUNAMADI";
        }
        StateHasChanged();
        await JS.InvokeVoidAsync("ultron.focus", _promptEl);
    }

    /// <summary>Yazı kutusuna Ctrl+V ile yapıştırılan görsel (ultron.js).</summary>
    [JSInvokable]
    public async Task OnImagePasted(string base64, string name)
    {
        if (_studioOpen && _studio is not null)
        {
            await _studio.SetPastedImageAsync(Convert.FromBase64String(base64), name);
            return;
        }
        if (_lessonOpen && _lesson is not null)
        {
            await _lesson.SetPastedImageAsync(Convert.FromBase64String(base64), name);
            return;
        }
        try
        {
            _pendingImage = new PendingImage(ImageTools.Prepare(Convert.FromBase64String(base64)), string.IsNullOrWhiteSpace(name) ? "yapıştırılan görsel" : name);
        }
        catch (Exception ex)
        {
            DesktopLog.Write("Yapıştırılan görsel okunamadı: " + ex.Message);
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Pencereye bırakılan dosyalar: görsel → soruya eklenir; belge → son kullanılan koleksiyona eklenir, sonuç sohbet kaydına yazılır.</summary>
    private async Task OnDroppedFilesAsync(InputFileChangeEventArgs e)
    {
        if (!_ready)
            return;
        var files = e.GetMultipleFiles(20);
        if (files.Count == 1 && ImageTools.IsImage(files[0].Name))
        {
            await SetPendingImageAsync(files[0]);
            return;
        }
        var item = new ChatItem(false, "Belge ekleniyor… Resimli (taranmış) sayfalar varsa yazı tanıma sayfa başına birkaç saniye sürebilir.") { Streaming = true };
        item.Chips.Add("BELGE");
        _messages.Add(item);
        _scrollPending = true;
        StateHasChanged();

        var lines = new List<string>();
        foreach (var file in files)
        {
            var result = await DocumentPanel.Upload(Client, file, DocumentPanel.Collection);
            lines.Add((result.Status == "Added" ? "✓ " : "✕ ") + result.Message);
            item.Text = string.Join("\n\n", lines);
            StateHasChanged();
        }

        if (lines.Any(l => l.StartsWith('✓')))
            lines.Add("Artık sorabilirsin: \"" + DocumentPanel.Collection + " notlarımda … ne yazıyor?\" Koleksiyonu /belgeler'den değiştirebilirsin.");
        item.Text = string.Join("\n\n", lines);
        item.Streaming = false;
        _scrollPending = true;
        StateHasChanged();
    }


    /// <summary>Ekranı sadece taneciklere döndürür. Konuşma silinmez, sadece görünümden kalkar.</summary>
    private void ReturnToIdle()
    {
        if (_busy)
            return;
        _messages.Clear();
        _statusPanelOpen = _memoryPanelOpen = _documentPanelOpen = _learningPanelOpen = false;
        PauseIdleTimer();
        StateHasChanged();
    }

    private void RestartIdleTimer() => _idleTimer?.Change(IdleAfter, Timeout.InfiniteTimeSpan);

    private void PauseIdleTimer() => _idleTimer?.Change(Timeout.Infinite, Timeout.Infinite);

    private void SetIdle()
    {
        _orbState = OrbState.Idle;
        _status = "ÇEVRİMİÇİ";
    }

    private void OnConnectionChanged() => InvokeAsync(() =>
    {
        if (!_ready)
            return;
        var state = Client.State;
        _status = state switch
        {
            Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected => _busy ? _status : "ÇEVRİMİÇİ",
            Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting => "YENİDEN BAĞLANIYOR",
            _ => "BAĞLANTI YOK",
        };
        _orbState = state == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected
            ? (_busy ? _orbState : OrbState.Idle)
            : OrbState.Error;
        StateHasChanged();
    });

    /// <summary>Hatırlatma sohbet kaydına da düşer (Windows bildirimi ve sesi uygulama verir: pencere kapalıyken de çalışsın).</summary>
    private void OnReminderDue(ReminderDueDto due) => InvokeAsync(() =>
    {
        // Tekrar eden hatırlatma yeni kart açmaz: mevcut kart "2. kez" diye güncellenir ve en alta taşınır.
        var item = _messages.LastOrDefault(m => m.ReminderId == due.Id && m.AwaitingAcknowledge);
        if (item is null)
        {
            item = new ChatItem(isUser: false, due.Spoken) { ReminderId = due.Id, AwaitingAcknowledge = due.NeedsAcknowledge };
            item.Chips.Add(due.Missed ? "KAÇIRILAN HATIRLATMA" : "HATIRLATMA");
            if (due.Priority != "Onemsiz")
                item.Chips.Add(due.Priority == "CokOnemli" ? "ÇOK ÖNEMLİ" : "ÖNEMLİ");
        }
        else
        {
            _messages.Remove(item);
            item.Repeats++;
        }
        _messages.Add(item);
        _scrollPending = true;
        StateHasChanged();
    });


    private void Apply(ChatItem reply, ChatEventDto e)
    {
        switch (e.Type)
        {
            case ChatEventTypes.Intent when e.Detailed == true && _splitter is not null:
                // Ayrıntı istendi: uzun cevap okunmaz (kullanıcı: "detaylı yaz dersem okumasın, ekrana yazıyorum desin").
                _splitter = null;
                _player?.Enqueue("Ekrana yazıyorum.");
                if (IntentLabel(e.Intent) is { } detailedLabel)
                    reply.Chips.Add(detailedLabel);
                break;
            case ChatEventTypes.Intent when IntentLabel(e.Intent) is { } label:
                reply.Chips.Add(label);
                break;
            case ChatEventTypes.Memories when e.RelevantMemories is { Count: > 0 } relevant:
                reply.Chips.Add($"HAFIZADAN {relevant.Count}");
                break;
            case ChatEventTypes.Web:
                reply.Chips.Add(e.FromCache == true ? "ÖNBELLEKTEN" : $"WEB · {e.Query}");
                _status = e.FromCache == true ? "ÖNBELLEK" : "KAYNAKLARI OKUYOR";
                break;
            case ChatEventTypes.Image:
                reply.Chips.Add(e.FromScreen == true ? "EKRAN GÖRÜNTÜSÜ" : "GÖRSEL");
                _status = "GÖRSELE BAKIYOR";
                break;
            case ChatEventTypes.Research:
                if (!reply.Chips.Contains("ARAŞTIRMA"))
                    reply.Chips.Add("ARAŞTIRMA");
                if (_splitter is not null)
                {
                    // Araştırma raporu uzun: okunmaz, ekrana yazılır.
                    _splitter = null;
                    _player?.Enqueue("Araştırıyorum, raporu ekrana yazıyorum.");
                }
                _status = (e.Text ?? "").ToUpper(new System.Globalization.CultureInfo("tr-TR"));
                break;
            case ChatEventTypes.Progress:
                // Cevap paketi ilerlemesi (Medium derin web, PRO Claude): sesli okuma kesilmez, sadece durum satırı.
                var tierChip = (e.Query ?? "").ToUpper(new System.Globalization.CultureInfo("tr-TR"));
                if (tierChip.Length > 0 && !reply.Chips.Contains(tierChip))
                    reply.Chips.Add(tierChip);
                _status = (e.Text ?? "").ToUpper(new System.Globalization.CultureInfo("tr-TR"));
                break;
            case ChatEventTypes.ResearchSaved when e.Text is not null:
                reply.Chips.Add("BİLGİ TABANINA KAYDEDİLDİ");
                break;
            case ChatEventTypes.Documents:
                reply.Chips.Add(e.Text is "0" ? "NOTLARDA YOK" : $"NOTLARDAN {e.Text}{(e.Query is { } scope ? " · " + scope.ToUpper(new System.Globalization.CultureInfo("tr-TR")) : "")}");
                _status = "NOTLARI OKUYOR";
                break;
            case ChatEventTypes.Library:
                reply.Chips.Add($"KÜTÜPHANEDEN {e.Text}");
                _status = "DOKÜMANTASYONA BAKIYOR";
                break;
            case ChatEventTypes.WebUnavailable:
                reply.Chips.Add("WEB KAPALI");
                break;
            case ChatEventTypes.Tools when e.Tools is not null:
                foreach (var tool in e.Tools)
                    reply.Chips.Add(ToolLabel(tool.Name) + (tool.Ok ? "" : " · HATA"));
                break;
            case ChatEventTypes.Chunk:
                reply.Text += e.Text;
                if (_splitter is not null && e.Text is not null)
                    foreach (var sentence in _splitter.Push(e.Text))
                        _player?.Enqueue(sentence);
                _orbState = OrbState.Speaking;
                _status = "YAZIYOR";
                break;
            case ChatEventTypes.Sources when e.Sources is not null:
                reply.Sources = e.Sources;
                break;
            case ChatEventTypes.Completed:
                reply.Streaming = false;
                if (e.Text is not null)
                    reply.Text = e.Text; // sunucu son metni düzeltmiş olabilir (ör. sondaki soru cümlesi atıldı)
                // Kalan yarım cümle: sunucu onu son metinden attıysa okunmaz.
                if (_splitter?.Flush() is { } rest && (e.Text is null || e.Text.Contains(rest)))
                    _player?.Enqueue(rest);
                // Sesli cevap kısa özet: uzun ya da maddeli cevabın sadece başı okunur, gerisi ekranda.
                if (_splitter is { ReachedList: true })
                    _player?.Enqueue("Ayrıntıları aşağıda listeledim, oradan okuyabilirsin.");
                else if (_splitter is { Truncated: true })
                    _player?.Enqueue("Devamını aşağıya yazdım.");
                _orbState = OrbState.Idle;
                _status = "ÇEVRİMİÇİ";
                break;
            case ChatEventTypes.FollowUps when e.FollowUps is { Count: > 0 } followUps:
                reply.FollowUps = followUps;
                reply.ExtraOpen = true;
                break;
        }
    }


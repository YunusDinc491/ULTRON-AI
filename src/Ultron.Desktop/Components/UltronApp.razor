@* ULTRON HUD (tasarım kararı): ortada Three.js nöral toz çekirdeği, üstte ince bilgi çubuğu,
   solda gerçek sistem telemetrisi (CPU, RAM, GPU, disk, pil, Ultron'un o anki işi), sağda sohbet kaydı, altta komut ve ses konsolu.
   Çekirdek kullanıcı yazarken/konuşurken genişler, Ultron düşünürken/konuşurken küçülüp sese göre titreşir. *@
@implements IDisposable
@using System.IO
@inject UltronClient Client
@inject HostLauncher Launcher
@inject IJSRuntime JS

<div class="hud-root">
    <div class="core" @ref="_core"></div>

    <div class="reticle" id="hud-reticle">
        <svg class="ring-a" viewBox="0 0 500 500">
            <circle cx="250" cy="250" r="238" fill="none" stroke="#00f0ff" stroke-width="0.7" stroke-dasharray="4 14" />
            <circle cx="250" cy="250" r="226" fill="none" stroke="#0088ff" stroke-width="1" stroke-dasharray="60 180 20 90" />
            <path d="M 250 6 L 250 18 M 250 482 L 250 494 M 6 250 L 18 250 M 482 250 L 494 250" stroke="#00f0ff" stroke-width="1.5" />
        </svg>
        <svg class="ring-b" viewBox="0 0 400 400">
            <circle cx="200" cy="200" r="188" fill="none" stroke="#ff6a00" stroke-width="1.2" stroke-dasharray="35 120 12 80" />
            <circle cx="200" cy="200" r="175" fill="none" stroke="#ffaa00" stroke-width="0.6" stroke-dasharray="2 10" />
        </svg>
    </div>

    @* Üst çubuk aynı zamanda pencerenin başlık çubuğu: boş yerinden sürüklenir (büyük pencerede), çift tık = panel ⇄ pencere. *@
    @if (_menuOpen)
    {
        @* Üst çubuğun backdrop-filter'ı fixed katmanı kendi içine hapseder; dışarı tıklayınca kapanma katmanı çubuğun dışında. *@
        <div class="brand-menu-backdrop" @onclick="() => _menuOpen = false"></div>
    }
    <header class="topbar @(_menuOpen ? "menu-open" : "")" id="topbar">
        @* (2026-10-29): üst çubukta sadece DERS ve İŞ; geri kalanlar logoya basınca açılan menüde. *@
        <div class="brand">
            <div>
                <button class="title-row brand-btn" title="Menü" aria-haspopup="menu" aria-expanded="@_menuOpen" @onclick="() => _menuOpen = !_menuOpen">
                    <img class="emblem @(_failed ? "err" : "")" src="img/ultron-emblem.png" alt="" draggable="false" />
                    <h1>ULTRON</h1>
                    <span class="brand-caret @(_menuOpen ? "open" : "")">▾</span>
                    @if (_learningCount > 0)
                    {
                        <span class="brand-badge" title="Bekleyen öğrenme önerisi">@_learningCount</span>
                    }
                </button>
                <p class="mono sub">ÇEKİRDEK: <span id="hud-mode">DENGE MODU (1.00x)</span></p>
            </div>
            @if (_menuOpen)
            {
                <nav class="brand-menu" role="menu">
                    <button role="menuitem" class="bm-item orange" @onclick='() => MenuAsync(() => RunCommandAsync("/yeni"))'>[YENİ KONUŞMA]</button>
                    <button role="menuitem" class="bm-item" title="Sistem durumu" @onclick='() => MenuAsync(() => RunCommandAsync("/durum"))'>[DURUM]</button>
                    <button role="menuitem" class="bm-item" title="Hafıza paneli" @onclick='() => MenuAsync(() => RunCommandAsync("/hafiza"))'>[HAFIZA]</button>
                    <button role="menuitem" class="bm-item" title="Belgeler (ders notları, PDF, raporlar)" @onclick='() => MenuAsync(() => RunCommandAsync("/belgeler"))'>[BELGELER]</button>
                    <button role="menuitem" class="bm-item" title="Öğrenme: düzeltmeler, PRO ve web'den öğrenilenler, bildiğim siteler" @onclick='() => MenuAsync(() => RunCommandAsync("/ogrenme"))'>[ÖĞRENME@(_learningCount > 0 ? $" {_learningCount}" : "")]</button>
                    <button role="menuitem" class="bm-item" title="Bağlı telefonlar ve eşleştirme kodu" @onclick='() => MenuAsync(() => RunCommandAsync("/mobil"))'>[MOBİL]</button>
                    <button role="menuitem" class="bm-item" title="Kurulum sihirbazı: yapay zekâ motoru, ses, web araması, hitap, ses örnekleri" @onclick='() => MenuAsync(() => RunCommandAsync("/kurulum"))'>[KURULUM]</button>
                    <button role="menuitem" class="bm-item mode" title="Gelişim: Ultron ne kadar öğreniyor, haftalık grafikler, gece raporları" @onclick="() => MenuAsync(EnterGrowthAsync, goHome: false)">[GELİŞİM ›]</button>
                </nav>
            }
        </div>
        @* Üç sekme (2026-10-31): üst çubuk her ekranda sabit, seçilen ekran altında piksel geçişiyle değişir. *@
        <nav class="cmds tabs" role="tablist" aria-label="Arayüz">
            <button role="tab" aria-selected="@(CurrentView == "is")" class="cmd mode @(CurrentView == "is" ? "on" : "")" title="İş: bileşen üret, canlı önizle" @onclick="EnterStudioAsync">[İŞ]</button>
            <button role="tab" aria-selected="@(CurrentView == "ana")" class="cmd mode @(CurrentView == "ana" ? "on" : "")" title="Ultron: sohbet, sistem ve günün özeti" @onclick='() => GoAsync("ana")'>[ULTRON]</button>
            <button role="tab" aria-selected="@(CurrentView == "ders")" class="cmd mode @(CurrentView == "ders" ? "on" : "")" title="Okul: kaynaklardan anlatım, quiz, sınav planı" @onclick="EnterLessonAsync">[OKUL]</button>
        </nav>
        <div class="right">
            <button class="sound-toggle" title="Sesli yanıt ve HUD sesleri" @onclick="ToggleSound">
                <span class="sdot @(_soundOn ? "on" : "")"></span><span>SES: @(_soundOn ? "AÇIK" : "KAPALI")</span>
            </button>
            <div class="clock mono">
                <div id="hud-clock">--:--:--</div>
                <div class="tag">ULTRON // NEURAL NET</div>
            </div>
            <div class="winbtns">
                <button title="Çerçevesiz tam ekran (F11)" @onclick="WindowBridge.ToggleFullScreen">⛶</button>
                <button title="Kenar paneli ⇄ büyük pencere" @onclick="WindowBridge.TogglePanelMode">⤢</button>
                <button title="Simgeye küçült" @onclick="WindowBridge.HideWindow">—</button>
                <button class="close" title="Kapat (simge ekranda kalır)" @onclick="WindowBridge.HideWindow">✕</button>
            </div>
        </div>
    </header>

    <div class="banner-wrap">
        <div class="banner">
            <span class="pdot @BannerClass"></span>
            <span class="mono banner-title @BannerClass @BannerState.ToLowerInvariant()" title="@_status">ULTRON <b>@BannerState</b></span>
        </div>
    </div>

    @* Kodlama şeridi (Faz 13): Claude Code'a verilen işin ilerlemesi; soru sorarsa cevap kutusu, bitince özet. *@
    @if (_coding is { } job && !_codingDismissed)
    {
        <div class="coding-strip @job.Status.ToLowerInvariant()">
            <div class="cs-head mono">
                <span>💻 KODLAMA #@job.Id · @job.Title.ToUpper(new System.Globalization.CultureInfo("tr-TR")) · @CodingLabel(job.Status)</span>
                @if (job.Status == "Calisiyor")
                {
                    <button class="cs-btn" @onclick="CancelCodingAsync">DURDUR</button>
                }
                else
                {
                    <button class="cs-btn" title="Proje klasörünü aç" @onclick="() => DocumentOpener.Open(job.Folder, null)">KLASÖR</button>
                    <button class="cs-btn" title="Kapat" @onclick="() => _codingDismissed = true">✕</button>
                }
            </div>
            @if (job.Status == "Calisiyor")
            {
                <div class="cs-prog mono">@(job.Progress ?? "çalışıyor…")</div>
            }
            else if (job.Status is "Soruyor" or "Bekliyor")
            {
                <div class="cs-q">@(job.Status == "Soruyor" ? job.Question : "Claude kullanım limiti doldu. Limit yenilenince devam ettir.")</div>
                <div class="cs-reply">
                    <input placeholder="@(job.Status == "Soruyor" ? "Claude'a cevabın…" : "devam et")" @bind="_codingReply" @bind:event="oninput"
                           @onkeydown='e => e.Key == "Enter" ? ReplyCodingAsync() : Task.CompletedTask' />
                    <button class="primary" @onclick="ReplyCodingAsync">@(job.Status == "Soruyor" ? "GÖNDER" : "DEVAM ET")</button>
                </div>
            }
            else if (job.LastMessage is { } summary)
            {
                <div class="cs-sum md">@((MarkupString)MarkdownRenderer.ToHtml(summary))</div>
            }
        </div>
    }

    @* Gerçek sistem verileri: değerler ve çizgi grafikler saniyede bir (SystemMonitor → ultronHud.metrics). *@
    <aside class="telemetry">
        <div class="hud-panel">
            <div class="ph"><span>SİSTEM TELEMETRİSİ</span><span class="live">● CANLI</span></div>
            @foreach (var (key, label, color) in Metrics)
            {
                <div class="metric">
                    <div class="mrow"><span>@label</span><b id="m-@key" class="@color">—</b></div>
                    <canvas class="spark" id="s-@key" data-color="@color"></canvas>
                </div>
            }
        </div>
        <div class="hud-panel orange guide">
            <div class="gt"><span></span>ULTRON ŞU AN</div>
            <div class="now @BannerClass">@NowText</div>
            <div class="mrow small"><span>SON İŞLEM</span><span class="last">@LastAction</span></div>
            <div class="mrow small"><span>ULTRON SÜREÇLERİ (RAM)</span><b id="m-ultron" class="o">—</b></div>
            <canvas class="spark small" id="s-ultron" data-color="o"></canvas>
        </div>
    </aside>

    @* Sağ bilgi paneli (2026-10-31): takvim, hava ve piyasa, Ultron. Dakikada bir sorulur; kurlar Host'ta 5 dakikada bir yenilenir. *@
    <aside class="telemetry info-side">
        <div class="hud-panel orange guide">
            <div class="gt"><span></span>BUGÜN</div>
            <div class="mrow small"><span>@(_info?.Date.ToUpper(Tr) ?? "—")</span></div>
            @if (_info is { Today.Count: > 0 })
            {
                @foreach (var line in _info.Today)
                {
                    <div class="info-line">@line</div>
                }
            }
            else
            {
                <div class="info-line muted">Bugün ders ya da hatırlatma yok.</div>
            }
            @if (_info?.NextExam is { } exam)
            {
                <div class="mrow small info-exam"><span>YAKLAŞAN SINAV</span></div>
                <div class="info-line">@exam</div>
            }
        </div>
        <div class="hud-panel">
            <div class="ph"><span>HAVA &amp; PİYASA</span><span class="live">● @(_info?.City.ToUpper(Tr) ?? "—")</span></div>
            <div class="metric">
                <div class="mrow"><span>HAVA</span><b>@(_info?.Weather ?? "—")</b></div>
                @if (_info?.WeatherDetail is { } detail)
                {
                    <div class="mrow small"><span>BUGÜN</span><span>@detail</span></div>
                }
            </div>
            @foreach (var r in _info?.Rates ?? [])
            {
                <div class="mrow"><span>@r.Name.ToUpper(Tr)</span><b>@r.Value.ToString("N2", Tr) ₺ @if (r.ChangePercent is { } c) {<span class="@(c >= 0 ? "info-up" : "info-down")">@(c >= 0 ? "▲" : "▼")@Math.Abs(c).ToString("0.00", Tr)%</span>}</b></div>
            }
            <div class="mrow small"><span>KUR</span><span>@(_info?.RatesNote ?? "—")</span></div>
        </div>
        <div class="hud-panel">
            <div class="ph"><span>ULTRON</span><span class="live">● @(_info is null ? "—" : Uptime(_info.UptimeMinutes))</span></div>
            <div class="metric">
                <div class="mrow"><span>SENİ TANIMA</span><b>%@(_info?.KnowPercent ?? 0)</b></div>
                <div class="info-bar"><span style="width:@(_info?.KnowPercent ?? 0)%"></span></div>
            </div>
            <div class="mrow"><span>HAFIZA</span><b>@(_info?.Memories ?? 0) bilgi · @(_info?.Categories ?? 0) başlık</b></div>
            <div class="mrow small"><span>BİRLİKTE</span><span>@(_info?.DaysTogether is { } d ? $"{d} gün" : "yeni tanıştık")</span></div>
        </div>
    </aside>

    @* Cevap kutusu (tasarım kararı): soru sorulunca ekranın ortasından açılır, 16:9 oranında ve cevabın uzunluğuna göre büyür;
       ✕ ile (ya da /temizle, Esc) küçülerek kapanır. Dar kenar panelinde altta, konsolun üstünde durur. *@
    @if (_messages.Count > 0)
    {
    <aside class="log-wrap size-@BoxSize @(_closingBox ? "closing" : "")">
        <div class="hud-panel log">
            <div class="ph">
                <span><i class="odot"></i>NÖRAL İLETİŞİM KAYDI</span>
                <button class="box-close" title="Konuşmayı kapat (Esc)" @onclick="CloseBoxAsync">✕</button>
            </div>
            <main class="messages" @ref="_messagesEl">
                @foreach (var m in _messages)
                {
                    @if (m.IsUser)
                    {
                        <div class="entry user">
                            <div class="who">OPERATÖR // SORU</div>
                            @if (m.ImagePreview is not null)
                            {
                                <img class="q-image" src="@m.ImagePreview" alt="" />
                            }
                            <div class="body plain">@m.Text</div>
                            @if (AnswerAfter(m) is { Streaming: false } answered)
                            {
                                <button class="plus @(answered.ExtraOpen ? "on" : "")" title="Bu konuya bilgi ekle / öneri al" @onclick="() => ToggleExtraAsync(m, answered)">+</button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="entry ultron">
                            <div class="who">
                                ULTRON // YANIT
                                @foreach (var chip in m.Chips)
                                {
                                    <span class="chip">@chip</span>
                                }
                            </div>
                            <div class="body md">@((MarkupString)MarkdownRenderer.ToHtml(m.Text, withCaret: m.Streaming))</div>
                            @if (m.ReminderId is not null && m.AwaitingAcknowledge)
                            {
                                <div class="ack">
                                    <button class="primary" @onclick="() => AcknowledgeAsync(m)">OKUDUM</button>
                                    <span class="muted">@(m.Repeats > 0 ? $"{m.Repeats + 1}. kez · " : "")okudum diyene kadar tekrar edecek</span>
                                </div>
                            }
                            @if (m.Sources.Count > 0)
                            {
                                <div class="sources">
                                    @foreach (var s in m.Sources)
                                    {
                                        @if (s.Path is not null)
                                        {
                                            <button class="source doc" title="Belgeyi aç: @s.Path" @onclick="() => OpenSource(s)">
                                                <span class="n">@s.Number</span>
                                                <span class="t">@s.Title</span>
                                                <span class="h">BELGE</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <a class="source" href="@s.Url" target="_blank" title="@s.Url">
                                                <span class="n">@s.Number</span>
                                                <span class="t">@s.Title</span>
                                                <span class="h">@HostOf(s.Url)</span>
                                            </a>
                                        }
                                    }
                                </div>
                            }
                            @if (m.ExtraOpen && !m.FollowUpsDone)
                            {
                                <div class="followups">
                                    <div class="fu-title">BU KONUYA EKLE@(m.LoadingExtra ? " · öneriler hazırlanıyor…" : "")</div>
                                    @for (var i = 0; i < m.FollowUps.Count; i++)
                                    {
                                        var index = i;
                                        var question = m.FollowUps[i];
                                        <div class="fu-q">@question.Question</div>
                                        <div class="fu-opts">
                                            @foreach (var option in question.Options)
                                            {
                                                var answer = option.Answer;
                                                <button class="opt @(m.Selected.GetValueOrDefault(index) == answer ? "on" : "")" title="@answer"
                                                        @onclick="() => ToggleOption(m, index, answer)">@option.Label</button>
                                            }
                                        </div>
                                    }
                                    <input class="fu-custom" placeholder="Eklemek istediğin bilgi (ör. bütçem 20 bin TL, vejetaryenim…)" @bind="m.CustomAnswer" @bind:event="oninput"
                                           @onkeydown='e => e.Key == "Enter" ? SendFollowUpsAsync(m) : Task.CompletedTask' />
                                    <div class="fu-actions">
                                        <button class="ghost" @onclick="() => m.ExtraOpen = false">Kapat</button>
                                        <button class="primary" disabled="@((m.Selected.Count == 0 && string.IsNullOrWhiteSpace(m.CustomAnswer)) || _busy)" @onclick="() => SendFollowUpsAsync(m)">Gönder</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </main>
        </div>
    </aside>
    }

    @* Panel açıkken arkasındaki görünmez katman: arayüze tıklayınca panel kapanır (2026-10-31; kurulum sihirbazı hariç). *@
    @if (AnyPanelOpen)
    {
        <div class="panel-backdrop" @onclick="ClosePanels"></div>
    }

    @if (_statusPanelOpen)
    {
        <StatusPanel Client="Client" OnClose="() => _statusPanelOpen = false" />
    }

    @if (_memoryPanelOpen)
    {
        <MemoryPanel Client="Client" OnClose="() => _memoryPanelOpen = false" />
    }

    @if (_documentPanelOpen)
    {
        <DocumentPanel Client="Client" OnClose="() => _documentPanelOpen = false" />
    }

    @if (_mobilePanelOpen)
    {
        <MobilePanel Client="Client" OnClose="() => _mobilePanelOpen = false" />
    }

    @if (_setupOpen)
    {
        <SetupWizard Client="Client" OnClose="() => _setupOpen = false" />
    }

    @if (_learningPanelOpen)
    {
        <LearningPanel Client="Client" OnClose="() => _learningPanelOpen = false" />
    }

    @* İş arayüzü (Faz 16): HUD'un üstünde tam pencere; çıkınca HUD olduğu gibi kalır. *@
    @if (_studioOpen)
    {
        <StudioView @ref="_studio" />
    }
    @* Ders arayüzü (Faz 17): aynı şekilde HUD'un üstünde tam pencere. *@
    @if (_lessonOpen)
    {
        <LessonView @ref="_lesson" />
    }
    @* Gelişim panosu (Faz 18): ana arayüz ailesinde tam ekran. *@
    @if (_growthOpen)
    {
        <GrowthView />
    }

    @* Pencereye dosya sürüklenince görünür; bırakılan dosya görünmez dosya seçiciye düşer (ultron.js). *@
    <div class="drop-zone" id="drop-zone">
        <div class="drop-card">
            <div class="drop-title">BELGE EKLE</div>
            <div class="muted">Belge (PDF, Word, .txt, .md) → @DocumentPanel.Collection koleksiyonuna eklenir · Görsel → soruna eklenir</div>
        </div>
        <InputFile OnChange="OnDroppedFilesAsync" multiple accept=".pdf,.docx,.txt,.md,.png,.jpg,.jpeg,.webp,.bmp,.gif" />
    </div>

    @if (_fullScreen)
    {
        <button class="fs-exit" title="Tam ekrandan çık (F11)" @onclick="WindowBridge.ToggleFullScreen">⤓</button>
    }

    <footer class="console">
        @if (_pendingImage is not null)
        {
            <div class="pending-image">
                <img src="@_pendingImage.Preview" alt="" />
                <span class="mono">GÖRSEL EKLİ · @_pendingImage.Name · sorunu yaz (boş bırakırsan ne olduğunu anlatırım)</span>
                <button title="Görseli kaldır" @onclick="() => _pendingImage = null">✕</button>
            </div>
        }
        <div class="hud-panel bar @(_draft.Length > 0 || _listening ? "active" : "")">
            <button class="mic @MicClass" title="@MicTitle" @onclick="OnMicAsync" disabled="@(!_ready)">@MicIcon</button>
            <label class="attach" title="Görsel ekle (ya da Ctrl+V ile yapıştır, pencereye sürükle). Ekran için: &quot;ekrana bak&quot;">
                📎
                <InputFile OnChange="OnImagePickedAsync" accept="image/*" disabled="@(!_ready)" />
            </label>
            <textarea id="prompt" rows="1" @ref="_promptEl" @bind="_draft" @bind:event="oninput" @onkeydown="OnPromptKeyDown"
                      placeholder="Soru sor veya komut gir…"
                      title="Enter: gönder · Shift+Enter: yeni satır · Esc: kapat" disabled="@(!_ready)"></textarea>
            <button class="send" title="Gönder" @ref="_sendEl" @onclick="SendDraftAsync"
                    disabled="@(!_ready || _busy || (string.IsNullOrWhiteSpace(_draft) && _pendingImage is null))">
                <span>GÖNDER</span>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" /></svg>
            </button>
        </div>
        @* Cevap paketi (Faz 19, tasarım kararı): yazma kutusunun altında, Claude Code'daki model seçici gibi; seçim kalıcı. *@
        <div class="tier-picker" role="radiogroup" aria-label="Cevap paketi">
            @foreach (var (key, label, hint) in Tiers)
            {
                <button role="radio" aria-checked="@(_tier == key)" class="tier @(key == "pro" ? "pro" : "") @(_tier == key ? "on" : "")" title="@hint" @onclick="() => SetTierAsync(key)">@label</button>
            }
            <span class="tier-hint mono @(_tierNotice is null ? "" : "warn")">@(_tierNotice ?? Tiers.FirstOrDefault(t => t.Key == _tier).Hint ?? Tiers[0].Hint)</span>
        </div>
        <div class="hint mono">🎙 konuş · /hafiza · /belgeler · /ogrenme · /durum · /yeni · /temizle · F11 tam ekran · Esc</div>
    </footer>
</div>

@code {
    private static readonly TimeSpan IdleAfter = TimeSpan.FromMinutes(2);

    private readonly List<ChatItem> _messages = [];
    private Guid _conversationId;
    private string _draft = "";
    private bool _ready, _busy, _failed, _scrollPending, _statusPanelOpen, _memoryPanelOpen, _documentPanelOpen, _learningPanelOpen, _fullScreen;

    private static readonly (string Key, string Label, string Hint)[] Tiers =
    [
        ("ultron", "Ultron", "yerel · akıllı okuma · TR+EN arama"),
        ("pro", "Ultron Pro", "bağlı hesap (Claude, Codex ya da Gemini) araştırır · cevap hafızaya girer"),
    ];

    private string _tier = "ultron";
    private string? _tierNotice;

    /// <summary>Pro ancak bağlı hesap varsa seçilir (2026-10-31); yoksa ne yapılacağı paket seçicinin yanında yazar.</summary>
    private async Task SetTierAsync(string tier)
    {
        _tierNotice = null;
        try
        {
            if (tier == "pro" && await Client.GetProStatusAsync() is { Ready: false } pro)
            {
                _tierNotice = pro.Message;
                return;
            }
            _tier = tier;
            await Client.SetAnswerTierAsync(tier);
        }
        catch (Exception ex)
        {
            DesktopLog.Write("Paket kaydedilemedi: " + ex.Message);
        }
    }

    private bool _studioOpen, _mobilePanelOpen, _setupOpen, _lessonOpen, _growthOpen, _switching;

    private bool AnyPanelOpen => _statusPanelOpen || _memoryPanelOpen || _documentPanelOpen || _learningPanelOpen || _mobilePanelOpen;

    private void ClosePanels() => _statusPanelOpen = _memoryPanelOpen = _documentPanelOpen = _learningPanelOpen = _mobilePanelOpen = false;

    // ---- Sağ bilgi paneli (2026-10-31) ----

    private CodingJobDto? _coding;
    private bool _codingDismissed;
    private string _codingReply = "";

    private void OnCodingUpdate(CodingJobDto job) => InvokeAsync(() =>
    {
        if (_coding?.Id != job.Id || _coding.Status != job.Status)
            _codingDismissed = false; // yeni iş ya da durum değişti (soru, bitti): şerit tekrar görünsün
        _coding = job;
        StateHasChanged();
    });

    private async Task ReplyCodingAsync()
    {
        var answer = _codingReply.Trim();
        if (_coding is null || (answer.Length == 0 && _coding.Status == "Soruyor"))
            return;
        _codingReply = "";
        try
        {
            _status = (await Client.ReplyCodingAsync(answer.Length == 0 ? "devam et" : answer)).ToUpper(new System.Globalization.CultureInfo("tr-TR"));
        }
        catch (Exception ex)
        {
            DesktopLog.Write("Kodlama cevabı gönderilemedi: " + ex.Message);
        }
    }

    private async Task CancelCodingAsync()
    {
        try { await Client.CancelCodingAsync(); }
        catch (Exception ex) { DesktopLog.Write("Kodlama durdurulamadı: " + ex.Message); }
    }


    protected override async Task OnInitializedAsync()
    {
        _player = new SpeechPlayer(Client.SpeakAsync);
        _player.SpeakingChanged += speaking => InvokeAsync(() =>
        {
            _speaking = speaking;
            StateHasChanged();
        });
        _player.LevelChanged += SendLevel;
        _recorder.LevelChanged += rms => SendLevel(Math.Min(1f, rms * 8)); // konuşma RMS'i ~0,02-0,15
        Client.StateChanged += OnConnectionChanged;
        Client.AppearanceChanged += OnAppearanceChanged;
        Client.ReminderDue += OnReminderDue;
        Client.Briefing += OnBriefing;
        Client.Suggestion += OnSuggestion;
        Client.CategoryCreated += OnCategoryCreated;
        WakeWordListener.MainWakeRequested += OnMainWake;
        Client.CodingUpdate += OnCodingUpdate;
        Client.LearningReady += OnLearningReady;
        ReminderAlerts.Acknowledged += OnReminderAcknowledged;
        WindowBridge.FullScreenChanged += OnFullScreenChanged;
        try
        {
            if (!await Launcher.IsRunningAsync())
            {
                _status = "SERVİS BAŞLATILIYOR";
                StateHasChanged();
                await Launcher.EnsureRunningAsync();
            }

            _status = "BAĞLANIYOR";
            StateHasChanged();
            await Client.StartAsync();
            // Konuşma kaldığı yerden devam eder (bağlam için), ama açılış ekranı sade: eski mesajlar gösterilmez.
            _conversationId = (await Client.GetCurrentConversationAsync()).Id;
            _tier = await Client.GetAnswerTierAsync();
            OnAppearanceChanged(await Client.GetAppearanceAsync());
            _ready = true;
            SetIdle();
            _infoTimer = new System.Threading.Timer(_ => _ = InvokeAsync(RefreshInfoAsync), null, TimeSpan.Zero, TimeSpan.FromMinutes(1));
            // Faz 26: sihirbaz hiç bitirilmediyse kendiliğinden açılır (yeni kurulum ya da güncellenmiş eski kurulum).
            try
            {
                _setupOpen = !(await Client.GetSetupStatusAsync()).Completed;
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                DesktopLog.Write("Kurulum durumu alınamadı: " + ex.Message);
            }
        }
        catch (Exception ex)
        {
            _failed = true;
            _orbState = OrbState.Error;
            _status = "Bağlanamadı: " + ex.Message;
        }
    }


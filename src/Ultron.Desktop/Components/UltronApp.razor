    private void ToggleOption(ChatItem item, int question, string option)
    {
        if (item.Selected.GetValueOrDefault(question) == option)
            item.Selected.Remove(question);
        else
            item.Selected[question] = option;
    }

    /// <summary>Seçilen cevaplar tek mesajda gider; seçenekler zaten tam cümle olduğu için hafızaya da doğru yazılır.</summary>
    /// <summary>Seçilen seçenekler + kullanıcının kendi yazdığı cevap tek mesajda gider (hafızaya da yazılır).</summary>
    private async Task SendFollowUpsAsync(ChatItem item)
    {
        var parts = item.Selected.OrderBy(x => x.Key).Select(x => x.Value.TrimEnd('.') + ".").ToList();
        if (item.CustomAnswer.Trim() is { Length: > 0 } custom)
            parts.Add(custom.TrimEnd('.') + ".");
        if (parts.Count == 0)
            return;
        item.FollowUpsDone = true;
        await SendAsync(string.Join(" ", parts));
    }

    private async Task SendAsync(string text, bool speak = false)
    {
        if (_busy || !_ready)
            return;

        // Hatırlatma çalarken "okudum" / "tamam": sohbete gitmez, hatırlatma susar.
        if (ReminderAlerts.HasActive && ReminderAlerts.IsAcknowledgeText(text))
        {
            _messages.Add(new ChatItem(isUser: true, text));
            await ReminderAlerts.AcknowledgeAllAsync(Client);
            _messages.Add(new ChatItem(isUser: false, "Tamam, hatırlatmayı kapattım."));
            _scrollPending = true;
            StateHasChanged();
            return;
        }

        _player?.Stop();
        _splitter = speak && _soundOn ? new SentenceSplitter { MaxSentences = MaxSpokenSentences, StopAtList = true, QuickStart = true } : null;
        _sendCts = new CancellationTokenSource();
        _busy = true;
        PauseIdleTimer();

        // Görsel: eklenmiş görsel ya da "ekrana bak" (sadece açıkça istenince ekran görüntüsü; bilgisayardan çıkmaz, kaydedilmez).
        var image = _pendingImage?.Jpeg;
        var fromScreen = false;
        _pendingImage = null;
        if (image is null && ImageTools.IsScreenRequest(text))
        {
            _status = "EKRANA BAKIYOR";
            StateHasChanged();
            try
            {
                image = await WindowBridge.CaptureScreenAsync();
                fromScreen = true;
            }
            catch (Exception ex)
            {
                DesktopLog.Write("Ekran görüntüsü alınamadı: " + ex.Message);
            }
        }

        _messages.Add(new ChatItem(isUser: true, text.Length > 0 ? text : "(görsel)") { ImagePreview = image is null ? null : ImageTools.DataUrl(image) });
        var reply = new ChatItem(isUser: false, "") { Streaming = true };
        _messages.Add(reply);
        _orbState = OrbState.Thinking;
        _status = "DÜŞÜNÜYOR";
        _scrollPending = true;
        StateHasChanged();

        try
        {
            var events = image is null
                ? Client.SendAsync(_conversationId, text, _sendCts.Token)
                : Client.SendWithImageAsync(_conversationId, text, image, fromScreen, _sendCts.Token);
            await foreach (var e in events)
            {
                Apply(reply, e);
                _scrollPending = true;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Mikrofona basılıp söz kesildi: cevap yarım kalır.
        }
        catch (Exception ex)
        {
            reply.Text += $"\n\n*(Bağlantı hatası: {ex.Message})*";
        }
        finally
        {
            reply.Streaming = false;
            _splitter = null;
            _sendCts.Dispose();
            _sendCts = null;
            _busy = false;
            SetIdle();
            RestartIdleTimer();
            _scrollPending = true;
            StateHasChanged();
            await JS.InvokeVoidAsync("ultron.focus", _promptEl);
        }
    }

    /// <summary>
    /// Mikrofon düğmesi. Dinlerken basılırsa kayıt hemen biter ve gönderilir. Ultron konuşurken ya da
    /// cevap yazarken basılırsa söz kesilir ve dinlemeye geçilir.

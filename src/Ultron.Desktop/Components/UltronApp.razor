            return;
        if (_menuOpen)
            _menuOpen = false;
        else if (_speaking || _listening)
        {
            // Önce sesi sustur / dinlemeyi iptal et; ekran olduğu gibi kalır.
            _player?.Stop();
            _abortRecording?.Cancel();
        }
        else if (_statusPanelOpen || _memoryPanelOpen || _documentPanelOpen || _learningPanelOpen || _mobilePanelOpen)
            _statusPanelOpen = _memoryPanelOpen = _documentPanelOpen = _learningPanelOpen = _mobilePanelOpen = false;
        else if (_fullScreen && string.IsNullOrEmpty(_draft))
            WindowBridge.ToggleFullScreen();
        else if (string.IsNullOrEmpty(_draft) && !_busy)
            _ = CloseBoxAsync();
    }


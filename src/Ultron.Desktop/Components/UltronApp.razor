    private void OnLearningReady(int reviewed, int learned, int pending) => InvokeAsync(() =>
    {
        _learningCount = pending;
        if (learned + pending > 0)
        {
            var text = $"Gece denetimi: {reviewed} yazılım cevabım okundu. "
                + (learned > 0 ? $"{learned} hatamı resmi kaynaklara göre düzelttim. " : "")
                + (pending > 0 ? $"{pending} öneri kaynak gösterilemediği için onayını bekliyor. " : "")
                + "Ayrıntı: /ogrenme";
            var item = new ChatItem(isUser: false, text);
            item.Chips.Add("📘 ÖĞRENME");
            _messages.Add(item);
            _scrollPending = true;
        }
        StateHasChanged();
    });


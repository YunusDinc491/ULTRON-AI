    private string CurrentView => _studioOpen ? "is" : _lessonOpen ? "ders" : _growthOpen ? "gelisim" : "ana";

    /// <summary>
    /// Arayüzler arası geçiş (2026-10-31): üst çubuk yerinde kalır; altındaki alan sağ alttan sol üste piksel piksel kapanır,
    /// ekran değişir, aynı yönde açılır (ultronTransition.cover / reveal).
    /// </summary>
    private async Task GoAsync(string target)
    {
        var current = CurrentView;
        if (current == target || _switching)
            return;
        _switching = true;
        try
        {
            await JS.InvokeAsync<bool>("ultronTransition.cover");

            _statusPanelOpen = _memoryPanelOpen = _documentPanelOpen = _learningPanelOpen = false;
            if (target != "ana")
                WindowBridge.EnsureLarge();
            _studioOpen = target == "is";
            _lessonOpen = target == "ders";
            _growthOpen = target == "gelisim";
            if (!_studioOpen)
                _studio = null;
            if (!_lessonOpen)
                _lesson = null;
            StateHasChanged();
            await Task.Delay(40); // yeni arayüz çizilsin

            await JS.InvokeVoidAsync("ultronTransition.reveal");
        }
        catch (JSException ex)
        {
            DesktopLog.Write("Geçiş efekti: " + ex.Message);
        }
        finally
        {
            _switching = false;
        }
        // İş ve Ders'te ses modelleri ekran kartından boşaltılır; Ana ve Gelişim'de yerinde.
        var mode = target is "is" or "ders" ? target : "ana";
        if (mode != (current is "is" or "ders" ? current : "ana"))
            _ = SetModeAsync(mode);
        StateHasChanged();
    }


    /// <summary>Ekran komutları sunucuya gitmez.</summary>
    private async Task<bool> TryRunCommandAsync(string text)
    {
        if (text.StartsWith('/') && !text.Equals("/mobil", StringComparison.OrdinalIgnoreCase))
            _mobilePanelOpen = false; // başka bir panel ya da komut açılınca Mobil kapanır
        switch (text.ToLowerInvariant())
        {
            case "/durum":
                _memoryPanelOpen = _documentPanelOpen = _learningPanelOpen = false;
                _statusPanelOpen = true;
                return true;
            case "/hafiza" or "/hafıza":
                _statusPanelOpen = _documentPanelOpen = _learningPanelOpen = false;
                _memoryPanelOpen = true;
                return true;
            case "/belgeler" or "/belge":
                _statusPanelOpen = _memoryPanelOpen = _learningPanelOpen = false;
                _documentPanelOpen = true;
                return true;
            case "/mobil":
                _statusPanelOpen = _memoryPanelOpen = _documentPanelOpen = _learningPanelOpen = false;
                _mobilePanelOpen = true;
                return true;
            case "/kurulum":
                _statusPanelOpen = _memoryPanelOpen = _documentPanelOpen = _learningPanelOpen = false;
                _setupOpen = true;
                return true;
            case "/is" or "/iş":
                await EnterStudioAsync();
                return true;
            case "/ders":
                await EnterLessonAsync();
                return true;
            case "/gelisim" or "/gelişim":
                await EnterGrowthAsync();
                return true;
            case "/ogrenme" or "/öğrenme":
                _statusPanelOpen = _memoryPanelOpen = _documentPanelOpen = _learningPanelOpen = false;
                _learningPanelOpen = true;
                _learningCount = 0;
                return true;
            case "/yeni":
                _conversationId = (await Client.StartNewConversationAsync()).Id;
                ReturnToIdle();
                return true;
            case "/temizle":
                await CloseBoxAsync();
                return true;
            case "/tamekran":
                WindowBridge.ToggleFullScreen();
                return true;
            default:
                return false;
        }
    }


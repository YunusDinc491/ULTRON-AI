    /// <summary>+: "bu konuya ekle" paneli; ilk açılışta öneri soruları Host'tan istenir (her cevaptan sonra otomatik değil).</summary>
    private async Task ToggleExtraAsync(ChatItem question, ChatItem answer)
    {
        answer.ExtraOpen = !answer.ExtraOpen;
        answer.FollowUpsDone = false;
        if (!answer.ExtraOpen || answer.FollowUps.Count > 0 || answer.LoadingExtra)
            return;
        answer.LoadingExtra = true;
        StateHasChanged();
        try
        {
            answer.FollowUps = await Client.SuggestFollowUpsAsync(question.Text, answer.Text);
        }
        catch (Exception ex)
        {
            DesktopLog.Write("Öneriler alınamadı: " + ex.Message);
        }
        answer.LoadingExtra = false;
        _scrollPending = true;
    }

    private async Task SendDraftAsync()
    {
        var text = _draft.Trim();
        if ((text.Length == 0 && _pendingImage is null) || _busy || !_ready)
            return;

        _draft = "";
        await JS.InvokeVoidAsync("ultron.resetComposer", _promptEl);
        if (await TryRunCommandAsync(text))

<!-- Ultron simgesi (kullanıcının seçtiği görsel), vektör olarak: koyu kare zemin, dönen kesikli halkalar, parlayan gözlü kask.
     Parçalar ayrı ayrı hareket eder: halkalar ters yönlerde döner, kask yavaşça sağa sola "döner" (3B salınım), gözler nefes alır.
     Durumlar (dinliyor / düşünüyor / konuşuyor) kod tarafında hız ve parlaklıkla gösterilir. -->
<UserControl x:Class="Ultron.Desktop.Widget.UltronEmblem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Canvas Width="1024" Height="1024">
            <!-- 3B salınım: tüm simge hafifçe daralıp genişler ve eğilir (Y ekseninde dönüyormuş gibi). -->
            <Canvas.RenderTransformOrigin>0.5,0.5</Canvas.RenderTransformOrigin>
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Yaw" ScaleX="1" />
                    <SkewTransform x:Name="Tilt" AngleY="0" CenterX="512" CenterY="512" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Zemin -->
            <Rectangle Canvas.Left="40" Canvas.Top="40" Width="944" Height="944" RadiusX="170" RadiusY="170" StrokeThickness="16">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.4" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#1B2230" Offset="0" />
                        <GradientStop Color="#0B0E14" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF8A1A" Offset="0" />
                        <GradientStop Color="#FF5A00" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Stroke>
                <Rectangle.Effect>
                    <DropShadowEffect x:Name="FrameGlow" Color="#FF6A00" BlurRadius="28" ShadowDepth="0" Opacity="0.55" />
                </Rectangle.Effect>
            </Rectangle>

            <!-- Dış halka (saat yönünde) -->
            <Ellipse Canvas.Left="102" Canvas.Top="102" Width="820" Height="820" Stroke="#FF7A00" StrokeThickness="22"
                     StrokeDashArray="5 3.2 1.6 2.4" StrokeDashCap="Flat" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="OuterRing" />
                </Ellipse.RenderTransform>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF6A00" BlurRadius="18" ShadowDepth="0" Opacity="0.8" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- İç halka (ters yönde) -->
            <Ellipse Canvas.Left="160" Canvas.Top="160" Width="704" Height="704" Stroke="#FFB000" StrokeThickness="12"
                     StrokeDashArray="2 2.6" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="InnerRing" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Kask: halkalardan bağımsız hafif kayma (derinlik / paralaks) -->
            <Canvas>
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="HeadShift" />
                </Canvas.RenderTransform>

                <!-- Yan kanatlar -->
                <Path Data="M 268 395 C 205 430 185 600 315 770 C 255 640 252 520 288 420 Z" Stroke="#6B7585" StrokeThickness="6">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3A414D" Offset="0" />
                            <GradientStop Color="#1A1E26" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="M 756 395 C 819 430 839 600 709 770 C 769 640 772 520 736 420 Z" Stroke="#6B7585" StrokeThickness="6">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Color="#3A414D" Offset="0" />
                            <GradientStop Color="#1A1E26" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="M 282 440 C 262 540 270 650 318 735" Stroke="#FF4A00" StrokeThickness="4" />
                <Path Data="M 742 440 C 762 540 754 650 706 735" Stroke="#FF4A00" StrokeThickness="4" />

                <!-- Kafa -->
                <Path Data="M 512 200 C 395 200 300 262 292 392 L 288 560 C 288 655 335 742 425 790 L 495 828 L 495 800 L 529 800 L 529 828 L 599 790 C 689 742 736 655 736 560 L 732 392 C 724 262 629 200 512 200 Z"
                      Stroke="#5C6573" StrokeThickness="7">
                    <Path.Fill>
                        <RadialGradientBrush Center="0.45,0.3" GradientOrigin="0.4,0.25" RadiusX="0.75" RadiusY="0.8">
                            <GradientStop Color="#2E3440" Offset="0" />
                            <GradientStop Color="#15181F" Offset="1" />
                        </RadialGradientBrush>
                    </Path.Fill>
                </Path>
                <!-- Alın çizgileri ve ek yerleri -->
                <Path Data="M 445 212 C 412 300 412 380 432 440 M 579 212 C 612 300 612 380 592 440" Stroke="#E0501A" StrokeThickness="4" />
                <Path Data="M 340 300 C 360 270 400 250 440 240 M 684 300 C 664 270 624 250 584 240" Stroke="#8A93A3" StrokeThickness="4" Opacity="0.7" />
                <Rectangle Canvas.Left="494" Canvas.Top="236" Width="36" Height="9" Fill="#FFB38A" RadiusX="3" RadiusY="3" />
                <Rectangle Canvas.Left="494" Canvas.Top="270" Width="36" Height="9" Fill="#FFB38A" RadiusX="3" RadiusY="3" />
                <Rectangle Canvas.Left="494" Canvas.Top="298" Width="36" Height="9" Fill="#FFB38A" RadiusX="3" RadiusY="3" />
                <Path Data="M 455 620 L 485 605 M 459 635 L 489 620 M 569 620 L 539 605 M 565 635 L 535 620" Stroke="#FF5A1A" StrokeThickness="4" />

                <!-- Işıklı yüz: gözler, yanaklar, ağız -->
                <Canvas x:Name="Face">
                    <Canvas.Effect>
                        <DropShadowEffect x:Name="EyeGlow" Color="#FF3A00" BlurRadius="30" ShadowDepth="0" Opacity="0.95" />
                    </Canvas.Effect>
                    <Path Data="M 368 458 C 380 430 432 428 474 445 C 484 500 452 528 420 528 C 384 524 362 492 368 458 Z" Fill="#FFF6EE" Stroke="#FF3A00" StrokeThickness="14" />
                    <Path Data="M 656 458 C 644 430 592 428 550 445 C 540 500 572 528 604 528 C 640 524 662 492 656 458 Z" Fill="#FFF6EE" Stroke="#FF3A00" StrokeThickness="14" />
                    <Ellipse Canvas.Left="300" Canvas.Top="552" Width="136" Height="168" StrokeThickness="18" Stroke="#FF4A00">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.45,0.4">
                                <GradientStop Color="#FFF8F0" Offset="0" />
                                <GradientStop Color="#FFD9C2" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="588" Canvas.Top="552" Width="136" Height="168" StrokeThickness="18" Stroke="#FF4A00">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.55,0.4">
                                <GradientStop Color="#FFF8F0" Offset="0" />
                                <GradientStop Color="#FFD9C2" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Path Data="M 430 690 L 470 690 M 554 690 L 594 690" Stroke="#FF4A00" StrokeThickness="12" />
                    <Rectangle x:Name="Mouth" Canvas.Left="468" Canvas.Top="676" Width="88" Height="34" RadiusX="6" RadiusY="6" Fill="#FFF3EA" Stroke="#FF4A00" StrokeThickness="8" />
                </Canvas>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>

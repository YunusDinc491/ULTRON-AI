<Window x:Class="Ultron.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:Ultron.Desktop.Components"
        Title="Ultron"
        Width="440" Height="800"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        ShowInTaskbar="True">

    <!-- Başlık çubuğu HUD'un kendi üst çubuğu (WebView içinde; sürükleme/düğmeler WindowBridge). Kenarlardan boyut değiştirilebilir. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="#0E2A33" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Background="{StaticResource Bg}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleButton}" Click="OnFullScreenClick"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Çerçevesiz tam ekran (F11)" Content="⛶" />
                    <Button x:Name="ModeButton" Style="{StaticResource TitleButton}" Click="OnModeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Büyük pencere" Content="⤢" />
                    <Button Style="{StaticResource TitleButton}" Click="OnHideClick"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Gizle (Ctrl+Alt+U)" Content="—" />
                    <Button Style="{StaticResource TitleButton}" Click="OnHideClick"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Kapat (tepside çalışmaya devam eder)" Content="✕" />
                </StackPanel>
                <!-- Başlık çubuğu boş: isim ve durum hemen altındaki üst bilgide. Burası sadece sürükleme alanı. -->
                <Border />
            </DockPanel>

            <blazor:BlazorWebView x:Name="WebView" Grid.Row="1" HostPage="wwwroot\index.html" Services="{DynamicResource services}">
                <blazor:BlazorWebView.RootComponents>
                    <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:UltronApp}" />
                </blazor:BlazorWebView.RootComponents>
            </blazor:BlazorWebView>
        </Grid>
    </Border>
</Window>
